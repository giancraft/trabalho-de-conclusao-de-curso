# --- IA generativa ---------------------------------------------------------------
# Qualquer provedor compatível com a API da OpenAI. Trocar de modelo é só mudar este
# bloco; o código não muda. Copie este arquivo para .env e preencha a chave.
#
# Padrão: gpt-oss-120b pelo OpenRouter (https://openrouter.ai/keys, créditos pré-pagos),
# servido pela Groq e, se ela falhar, pela Cerebras. Foi o mais rápido e o que melhor
# seguiu o prompt na comparação de 24/10 (vs. DeepSeek V4 Flash, Qwen3-235B, GLM-5.3 Flash).
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_PROVIDERS=groq,cerebras
# LLM_BASE_URL=https://openrouter.ai/api/v1   (padrão)
# LLM_JSON=estrito                            (padrão: json_schema garantido pelo provedor)
#
# Outras receitas (descomente e troque o bloco acima):
#   DeepSeek V4 Flash pelo OpenRouter, em provedores fora da China (mais barato, mas
#   ~4x mais lento e segue pior o prompt no teste de 24/10):
#     LLM_MODEL=deepseek/deepseek-v4-flash
#     LLM_PROVIDERS=deepinfra,digitalocean,parasail
#   Groq direto (https://console.groq.com/keys):
#     LLM_BASE_URL=https://api.groq.com/openai/v1
#     LLM_MODEL=openai/gpt-oss-120b
#   Cerebras direto (https://cloud.cerebras.ai):
#     LLM_BASE_URL=https://api.cerebras.ai/v1
#     LLM_MODEL=gpt-oss-120b
#   DeepSeek oficial (só json_object; servidores na China):
#     LLM_BASE_URL=https://api.deepseek.com
#     LLM_MODEL=deepseek-chat
#     LLM_JSON=json

# Qual profile do compose.yaml sobe com `docker compose up` sem flag. Produção:
# COMPOSE_PROFILES=prod docker compose up --build -d
COMPOSE_PROFILES=dev

# Só para rodar o backend fora do Docker; dentro do compose isto vem pronto.
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/simulador
