# Copie este arquivo para .env e preencha sua chave da Groq (https://console.groq.com/keys)
GROQ_API_KEY=
# O modo `strict` (schema garantido por constrained decoding) exige um modelo que o
# suporte — GPT-OSS 120B/20B ou Qwen. O llama-3.3-70b não suporta.
GROQ_MODEL=openai/gpt-oss-120b

# Qual profile do compose.yaml sobe com `docker compose up` sem flag. Produção:
# COMPOSE_PROFILES=prod docker compose up --build -d
COMPOSE_PROFILES=dev

# Só para rodar o backend fora do Docker; dentro do compose isto vem pronto.
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/simulador
